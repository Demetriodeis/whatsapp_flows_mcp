{
  "name": "whatsapp-flows-blip-mcp",
  "version": "0.2.0",
  "description": "MCP server para criar, editar, publicar e gerenciar WhatsApp Flows via API de Commands da Blip",
  "type": "module",
  "main": "dist/transports/azure/functions.js",
  "bin": {
    "whatsapp-flows-blip-mcp": "dist/transports/stdio.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "host.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "watch": "tsc -w",
    "start": "node dist/transports/stdio.js",
    "start:http": "node dist/transports/http/nodeHttpServer.js",
    "start:func": "npm run build && func start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run lint && npm run format:check && npm test",
    "inspector": "npx @modelcontextprotocol/inspector node dist/transports/stdio.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "blip",
    "whatsapp",
    "whatsapp-flows",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
