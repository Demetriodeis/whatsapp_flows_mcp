{
  "name": "whatsapp-flows-blip-mcp",
  "version": "0.1.0",
  "description": "MCP server para criar, editar, publicar e gerenciar WhatsApp Flows via API de Commands da Blip",
  "type": "module",
  "main": "dist/functions/*.js",
  "bin": {
    "whatsapp-flows-blip-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "host.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/httpServer.js",
    "start:func": "npm run build && func start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "blip",
    "whatsapp",
    "whatsapp-flows",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
