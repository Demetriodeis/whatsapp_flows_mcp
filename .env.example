# Chave do bot/roteador na Blip (Configurações > Informações de conexão > Header de autenticação).
# Pode ser informada com ou sem o prefixo "Key ".
BLIP_API_KEY=Key SUA_CHAVE_AQUI

# Id do contrato (tenant) da Blip. A URL de commands será https://{BLIP_CONTRACT_ID}.http.msging.net/commands
BLIP_CONTRACT_ID=seu-contrato

# Opcional: URL completa para commands (sobrepõe BLIP_CONTRACT_ID)
# BLIP_COMMANDS_URL=https://seu-contrato.http.msging.net/commands

# Opcional: destinatário dos commands de WhatsApp Flows (padrão: postmaster@wa.gw.msging.net)
# BLIP_FLOWS_TO=postmaster@wa.gw.msging.net

# Opcional: timeout das requisições em ms (padrão: 60000)
# BLIP_TIMEOUT_MS=60000
